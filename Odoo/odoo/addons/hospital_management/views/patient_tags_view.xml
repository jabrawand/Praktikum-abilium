<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="patient_tags_view_list" model="ir.ui.view">
        <field name="name">patient.tags.view.list</field>
        <field name="model">patient.tags</field>
        <field name="arch" type="xml">
            <list string="Patient Tags" editable="top">
                <field name="name"/>
                <field name="sequence" widget="handle"/>
                
            </list>
        </field>
    </record>

    <record id="action_patient_tags_view" model="ir.actions.act_window">
        <field name="name">Patient Tags</field>
        <field name="res_model">patient.tags</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new patient tag
            </p>
        </field>    
        
    </record> 

</odoo>
