<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hospital_management_readonly_view_list" model="ir.ui.view">
            <field name="name">hospital.management.readonly.view.list</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <list string="View Patients" create="0" delete="0" edit="0">
                    <field name="firstname"/>
                    <field name="name"/>
                    <field name="dob" optional="show"/>
                    <field name="gender" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="hospital_management_readonly_view_form" model="ir.ui.view">
            <field name="name">hospital.management.readonly.form</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <form string="View Patients" create="0" delete="0" edit="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="firstname"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="gender"/>
                                <field name="dob"/>
                            </group>
                        </group>

                    </sheet>
                    
                    
                </form>
            </field>
        </record>
         
         <record id="action_hospital_patient_readonly_view" model="ir.actions.act_window">
            <field name="name">View Patients</field>
            <field name="res_model">hospital.patient</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a new patient
                </p>
            </field>    
            <field name="view_ids" eval="[Command.clear(), 
            (0,0, {'view_mode':'list', 'view_id':ref('hospital_management_readonly_view_list')}), 
            (0,0, {'view_mode':'form', 'view_id':ref('hospital_management_readonly_view_form')})]"/>
        </record> 
        

        
    </data>

</odoo>