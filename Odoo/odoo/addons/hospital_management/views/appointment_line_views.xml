<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hospital_appointment_line_view_list" model="ir.ui.view">
            <field name="name">hospital.appointment.line.view.list</field>
            <field name="model">hospital.appointment.line</field>
            <field name="arch" type="xml">
                <list string="Appointment Lines" editable="top">
                    <field name="appointment_id"/>
                    <field name="product_id"/>
                    <field name="qty"/>
                </list>
            </field>
        </record>
       
         
         <record id="action_hospital_appointment_line_view" model="ir.actions.act_window">
            <field name="name">Appointment Line</field>
            <field name="res_model">hospital.appointment.line</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontet_smiling_face">
                    Create a new appointment line
                </p>
            </field>
            <field name="view_id" ref="hospital_appointment_line_view_list"/>  
        </record> 
        

        
    </data>

</odoo>
