<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="sale_order_inherit" model="ir.ui.view">
            <field name="name">sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml"/>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="patient_name"/>
                </xpath>
        </record>

        <record id="hospital_management_view_list" model="ir.ui.view">
            <field name="name">hospital.management.view.list</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="firstname"/>
                    <field name="name"/>
                    <field name="dob" optional="show"/>
                    <field name="gender" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="hospital_management_view_form" model="ir.ui.view">
            <field name="name">hospital.management.form</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <form string="Patients">
                    <sheet>
                        <group>
                            <group>
                                <field name="firstname"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="gender"/>
                                <field name="dob"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hospital_patient_view" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hospital.patient</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a new patient
                </p>
            </field>    
            <field name="view_ids" eval="[Command.clear(), 
            (0,0, {'view_mode':'list', 'view_id':ref('hospital_management_view_list')}), 
            (0,0, {'view_mode':'form', 'view_id':ref('hospital_management_view_form')})]"/> 
        </record> 
        

        
    </data>

</odoo>
