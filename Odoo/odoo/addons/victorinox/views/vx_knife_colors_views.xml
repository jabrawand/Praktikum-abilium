<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!--View List-->
        <record id="victorinox_knife_colors_view_list" model="ir.ui.view">
            <field name="name">victorinox.knife.colors.view.list</field>
            <field name="model">vx.knife.colors</field>
            <field name="arch" type="xml">
                <list string="Color">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!--View Form-->
        <record id="victorinox_knife_colors_view_form" model="ir.ui.view">
            <field name="name">victorinox.knife.colors.form</field>
            <field name="model">vx.knife.colors</field>
            <field name="arch" type="xml">
                <form string="Color">
                    <group name="color" string="colors">
                        <field name="name"/> 
                    </group>
                    
                </form>
            </field>

        </record>

        <!--Action View-->
        <record id="action_victorinox_knife_colors_view" model="ir.actions.act_window">
            <field name="name">Colors</field>
            <field name="res_model">vx.knife.colors</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="victorinox_knife_colors_view_list"/>

        </record>
    
        
    
    </data>
    

</odoo>
