<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!--View List-->
        <record id="victorinox_knives_view_list" model="ir.ui.view">
            <field name="name">victorinox.knives.view.list</field>
            <field name="model">vx.knives</field>
            <field name="arch" type="xml">
                <list string="Knives">
                    <field name="article_number"/>
                    <field name="name"/>
                    <field name="color_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!--View Form-->
        <record id="victorinox_knives_view_form" model="ir.ui.view">
            <field name="name">victorinox.knives.form</field>
            <field name="model">vx.knives</field>
            <field name="arch" type="xml">
                <form string="Knives">
                    <group name="knives" string="Knives">
                        <field name="article_number"/>
                        <field name="name"/> 
                        <field name="color_ids"/>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                           
                        </page>
                    </notebook>
                    
                </form>
            </field>

        </record>

        <!--Action View-->
        <record id="action_victorinox_knives_view" model="ir.actions.act_window">
            <field name="name">Knives</field>
            <field name="res_model">vx.knives</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="victorinox_knives_view_list"/>

        </record>
    
        
    
    </data>
    

</odoo>
